# Added to the host profile for the tsan presets (ICS-011): the dependencies
# are built with ThreadSanitizer too, because TSan cannot see synchronization
# inside uninstrumented code and would report false races or miss real ones.
# Only host packages get the flags; build tools such as CMake do not. The flags
# are part of the package ID, so sanitized and plain builds never mix in the
# cache.
[conf]
tools.build:cflags+=["-fsanitize=thread"]
tools.build:cxxflags+=["-fsanitize=thread"]
tools.build:exelinkflags+=["-fsanitize=thread"]
tools.build:sharedlinkflags+=["-fsanitize=thread"]
tools.info.package_id:confs+=["tools.build:cflags", "tools.build:cxxflags", "tools.build:exelinkflags", "tools.build:sharedlinkflags"]
